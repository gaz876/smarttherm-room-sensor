menu "Room sensor"
config ROOM_SAMPLE_INTERVAL_S
    int "Measurement interval (seconds)"
    range 1 3600
    default 10
config ROOM_I2C_SDA
    int "SDA GPIO (verify actual board)"
    range 0 21
    default 4
config ROOM_I2C_SCL
    int "SCL GPIO (verify actual board)"
    range 0 21
    default 5
endmenu
