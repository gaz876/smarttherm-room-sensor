menu "Room sensor"
config ROOM_SAMPLE_INTERVAL_S
    int "Measurement interval (seconds)"
    range 1 3600
    default 10
config ROOM_I2C_SDA
    int "SDA GPIO (fixed provisional SuperMini profile)"
    range 4 4
    default 4
config ROOM_I2C_SCL
    int "SCL GPIO (fixed provisional SuperMini profile)"
    range 5 5
    default 5
config ROOM_WIFI_HMAC_KEY_ID
    int "Previously provisioned HMAC key ID (-1 disables Wi-Fi)"
    range -1 5
    default -1
    help
        Experimental only. Select an approved existing protected key; never creates a key.
endmenu
